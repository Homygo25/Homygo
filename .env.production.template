# Production Environment Configuration for Finder Laravel Application
# Copy this file to .env and fill in your production values

# ================================
# APPLICATION SETTINGS
# ================================
APP_NAME="Finder - Property Listings"
APP_ENV=production
APP_KEY=                                    # GENERATE NEW: php artisan key:generate
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://your-domain.com             # Your production domain

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# ================================
# LOGGING
# ================================
LOG_CHANNEL=stack
LOG_STACK=single,slack                     # Add slack for error notifications
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error                             # Only log errors in production

# ================================
# DATABASE CONFIGURATION
# ================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1                          # Your database host
DB_PORT=3306
DB_DATABASE=finder_production               # Your production database name
DB_USERNAME=finder_user                     # Database user with minimal permissions
DB_PASSWORD=                                # STRONG database password

# ================================
# SESSION & CACHE
# ================================
SESSION_DRIVER=redis                       # Use Redis for better performance
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.your-domain.com             # Your domain for session cookies
SESSION_SECURE_COOKIE=true                 # HTTPS only
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=redis
FILESYSTEM_DISK=s3                         # Use S3 for file storage
QUEUE_CONNECTION=redis                      # Use Redis for queues

CACHE_STORE=redis
CACHE_PREFIX=finder_

# ================================
# REDIS CONFIGURATION
# ================================
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1                       # Your Redis host
REDIS_PASSWORD=                             # Redis password if required
REDIS_PORT=6379

# ================================
# EMAIL CONFIGURATION
# ================================
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=                                  # Your SMTP host (e.g., smtp.mailgun.org)
MAIL_PORT=587
MAIL_USERNAME=                              # Your SMTP username
MAIL_PASSWORD=                              # Your SMTP password
MAIL_FROM_ADDRESS="noreply@your-domain.com"
MAIL_FROM_NAME="Finder - Property Listings"

# ================================
# AWS S3 CONFIGURATION (for file storage)
# ================================
AWS_ACCESS_KEY_ID=                          # Your AWS access key
AWS_SECRET_ACCESS_KEY=                      # Your AWS secret key
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=finder-uploads                   # Your S3 bucket name
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_URL=                                    # Optional: CloudFront URL

# ================================
# THIRD PARTY SERVICES
# ================================

# Error Tracking (Sentry)
SENTRY_LARAVEL_DSN=                         # Your Sentry DSN for error tracking

# Google Maps (for location features)
GOOGLE_MAPS_API_KEY=                        # Your Google Maps API key

# Pusher (for real-time features)
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

# ================================
# SECURITY SETTINGS
# ================================

# Rate Limiting
THROTTLE_LOGIN_ATTEMPTS=5                   # Max login attempts per minute
THROTTLE_REGISTRATION_ATTEMPTS=3            # Max registration attempts per minute
THROTTLE_PASSWORD_RESET_ATTEMPTS=3          # Max password reset attempts per minute

# File Upload Limits
MAX_FILE_SIZE=2048                          # Max file size in KB (2MB)
ALLOWED_IMAGE_TYPES=jpeg,jpg,png,webp       # Allowed image types

# ================================
# MONITORING & PERFORMANCE
# ================================

# Application Performance Monitoring
APM_SERVICE_NAME=finder-laravel
APM_ENVIRONMENT=production

# ================================
# BACKUP CONFIGURATION
# ================================
BACKUP_DISK=s3                              # Where to store backups
BACKUP_NOTIFICATION_EMAIL=admin@your-domain.com

VITE_APP_NAME="${APP_NAME}"
